# Instance Partiduo {{DOSSIER}} — généré par partiduo-provision. Installé dans
# /usr/local/etc/nginx/partiduo/{{DOSSIER}}.conf (nginx.conf : include partiduo/*.conf;).
# Certificat : un certificat Let's Encrypt propre à l'instance (ADR-001 D2),
# obtenu par acme.sh (utilisateur acme) en HTTP-01 sur {{ACME_WEBROOT}} et
# laissé dans son CERT_HOME, /var/db/acme/certs/{{HOST}}_ecc/ (conventions du
# port FreeBSD security/acme.sh ; voir INSTALL.txt et nginx-acme.conf.tmpl, le
# vhost d'amorçage). Le cron d'acme.sh (/usr/local/etc/cron.d/acme, recette
# beryl `acme`) le renouvelle et recharge nginx par sudo.

# Routes publiques, sans connexion : /p/<extension>/… (public_mount de
# l'interface, ex. /p/form/<jeton> de partiduo-form) et l'ancienne adresse
# /f/<jeton>, redirigée en 308 (A-FRM-4, D-PKG-010). L'adresse porte un
# secret : ces requêtes ont leur propre format de journal, sans chemin
# (« <route publique> »), sans chaîne de requête ni référent (un envoi depuis
# la page porte l'adresse dans Referer), et un débit limité par adresse,
# commun à tous les processus de l'instance. Noms propres à l'instance : ce
# fichier est inclus dans le bloc http de nginx.conf.
log_format partiduo_{{DOSSIER}}_public
  '$remote_addr - [$time_local] "$request_method <route publique> $server_protocol" '
  '$status $body_bytes_sent "$http_user_agent" $request_time';
limit_req_zone $binary_remote_addr zone=partiduo_{{DOSSIER}}_public:1m rate=30r/m;

server {
  listen      80;
  listen      [::]:80;
  server_name {{HOST}};

  # Défis ACME : renouvellement du certificat par acme.sh (webroot).
  location ^~ /.well-known/acme-challenge/ {
    root {{ACME_WEBROOT}};
    default_type text/plain;
  }

  # Routes publiques appelées en HTTP : redirigées sans journaliser leur
  # adresse.
  location ~ ^/(f|p)/ {
    access_log off;
    return 301 https://$host$request_uri;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen      443 ssl;
  listen      [::]:443 ssl;
  http2       on;
  server_name {{HOST}};

  ssl_certificate     /var/db/acme/certs/{{HOST}}_ecc/fullchain.cer;
  ssl_certificate_key /var/db/acme/certs/{{HOST}}_ecc/{{HOST}}.key;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

  # Pièces jointes et imports (FEC) : limite volontairement large.
  client_max_body_size 32m;

  access_log /var/log/nginx/partiduo-{{DOSSIER}}.access.log;
  error_log  /var/log/nginx/partiduo-{{DOSSIER}}.error.log;

  # Adresse du client : celle de la connexion, jamais une valeur reçue
  # (X-Real-IP et X-Forwarded-For sont écrasés, pas complétés) ; les
  # limites de débit de l'instance en dépendent (A-FRM-4).
  location / {
    proxy_pass         http://127.0.0.1:{{PORT}};
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  # Routes publiques (/p/…, /f/…) : journal sans adresse, débit limité (30
  # requêtes par minute et par adresse, 20 d'avance), refus en 429. Le
  # journal d'erreurs ne garde ici que le critique : un refus de débit ou
  # une erreur du serveur y écrirait la ligne de requête, donc le secret.
  # HSTS : hérité du serveur (aucun add_header ici, qui l'annulerait).
  # Expression régulière : prioritaire sur « location / », simple préfixe.
  location ~ ^/(f|p)/ {
    limit_req           zone=partiduo_{{DOSSIER}}_public burst=20 nodelay;
    limit_req_status    429;
    limit_req_log_level notice;
    access_log /var/log/nginx/partiduo-{{DOSSIER}}.access.log partiduo_{{DOSSIER}}_public;
    error_log  /var/log/nginx/partiduo-{{DOSSIER}}.error.log crit;

    proxy_pass         http://127.0.0.1:{{PORT}};
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }
}
